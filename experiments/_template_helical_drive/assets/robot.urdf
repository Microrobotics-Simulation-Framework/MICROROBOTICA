<?xml version="1.0"?>
<!--
  robot.urdf — PLACEHOLDER ARM for the helical-UMR drive template.

  This is a minimal 3-link planar revolute manipulator copied from the
  MIME control fixture `tests/control/fixtures/three_link_planar.urdf`
  and re-authored here so the experiment is self-contained.

  REPLACE WITH YOUR OWN URDF for production use:
    1. Copy your URDF (and any referenced meshes) into `assets/`.
    2. Update `physics/params.py:END_EFFECTOR_LINK_NAME` to the link
       on which the motor housing should mount.
    3. Update `scene/world.usda` to declare one Xform per URDF link
       (each tagged with `customData = { string mimeNodeName =
       "arm_link_<urdf_link_name>" }`).
    4. Update the `scene.actors` list in `experiment.yaml` to match.

  Geometry of the placeholder:
    base_link -> [joint_1: revolute z @ origin]    -> link_1 (L1=1.0, +x)
       link_1 -> [joint_2: revolute z @ +x*L1 ]    -> link_2 (L2=1.0, +x)
       link_2 -> [joint_3: revolute z @ +x*L2 ]    -> link_3 (L3=0.5, +x)
  All joints rotate about world +z. Masses: m1=2.0, m2=1.5, m3=0.5 kg.
  No visual/collision meshes — kinematics-only.
-->
<robot name="placeholder_three_link_planar">

  <link name="base_link"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="10"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="link_1">
    <inertial>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0"
               iyy="0.16666666666666666" iyz="0.0"
               izz="0.16666666666666666"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="10"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="link_2">
    <inertial>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0"
               iyy="0.125" iyz="0.0"
               izz="0.125"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="10"/>
    <dynamics damping="0.02"/>
  </joint>

  <link name="link_3">
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0"
               iyy="0.010416666666666666" iyz="0.0"
               izz="0.010416666666666666"/>
    </inertial>
  </link>

</robot>
