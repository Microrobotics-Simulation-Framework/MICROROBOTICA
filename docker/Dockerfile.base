# MICROBOTICA Base Development Image
#
# Contains all dependencies including OpenUSD built from source.
# Rebuild only when dependencies change (rare).
#
# Usage:
#   docker build -f docker/Dockerfile.base -t ghcr.io/microrobotics-simulation-framework/microrobotica:base .
#   docker push ghcr.io/microrobotics-simulation-framework/microrobotica:base
#
# For CI, the dev image (Dockerfile) layers MICROBOTICA source on top of this.

FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-13 g++-13 \
    cmake \
    ninja-build \
    git \
    python3 python3-dev python3-pip python3-venv \
    # Qt6 + XKB (required by Qt xcb platform plugin)
    qt6-base-dev libqt6openglwidgets6t64 \
    libxkbcommon-dev \
    # Mesa software rendering (for headless/Docker GUI)
    libgl1-mesa-dri libegl-mesa0 libgbm1 \
    # C++ libraries
    nlohmann-json3-dev \
    libspdlog-dev \
    catch2 \
    pybind11-dev \
    cppzmq-dev \
    libzmq5 \
    # OpenUSD build dependencies
    libboost-all-dev \
    libtbb-dev \
    libglew-dev \
    libgl-dev \
    libx11-dev \
    # Documentation tools
    doxygen \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Set GCC 13 as default
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100

# Python packages (for compliance scripts and docs)
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir \
    PyYAML \
    sphinx \
    myst-parser \
    breathe \
    sphinxcontrib-bibtex

# ── Build OpenUSD from source ──────────────────────────────────────────────────
# This is the expensive step (~45 min). Cached as a Docker layer.

ARG USD_VERSION=v24.08
ARG USD_INSTALL=/opt/usd

RUN git clone --depth 1 --branch ${USD_VERSION} \
    https://github.com/PixarAnimationStudios/OpenUSD.git /tmp/OpenUSD

# Build USD with core + imaging but no heavyweight render delegates.
# UsdGeom (xformOps) and UsdImaging are needed; Embree/Prman/OIIO are not.
# --onetbb: use modern oneTBB instead of deprecated Intel TBB (eliminates
#   "tbb/task.h is deprecated" warnings that propagate through USD headers).
RUN cd /tmp/OpenUSD && python3 build_scripts/build_usd.py \
    --no-tests \
    --no-examples \
    --no-tutorials \
    --no-docs \
    --no-python \
    --no-usdview \
    --no-embree \
    --no-prman \
    --no-openimageio \
    --no-opencolorio \
    --no-materialx \
    --onetbb \
    /opt/usd \
    && rm -rf /tmp/OpenUSD

ENV PXR_ROOT=${USD_INSTALL}
ENV PATH="${USD_INSTALL}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${USD_INSTALL}/lib"
ENV CMAKE_PREFIX_PATH="${USD_INSTALL}"

# Verify USD installation
RUN ls ${USD_INSTALL}/include/pxr/usd/usd/api.h && echo "OpenUSD headers OK" \
    || echo "WARNING: USD headers not found — build may have used different layout"

# ── Labels ─────────────────────────────────────────────────────────────────────

LABEL org.opencontainers.image.source="https://github.com/Microrobotics-Simulation-Framework/MICROROBOTICA"
LABEL org.opencontainers.image.description="MICROBOTICA base development image with OpenUSD ${USD_VERSION}"
LABEL org.opencontainers.image.licenses="AGPL-3.0-or-later"

WORKDIR /workspace
