PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "MICROROBOTs Iterative Simulation for Clinical Adoption"

INPUT                  = src/
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp

GENERATE_HTML          = NO
